<Window x:Class="CalculatorZotovaK41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalculatorZotovaK41" Height="500" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поле ввода и история -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="HistoryTextBlock" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="Gray" FontSize="16" Margin="0,0,5,5"/>
            <TextBox x:Name="DisplayTextBox" Grid.Row="1" FontSize="32" FontWeight="Bold" TextAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="True" BorderThickness="1" Background="White"/>
        </Grid>

        <!-- Кнопки -->
        <Grid Grid.Row="1" Grid.RowSpan="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1 ряд: C, Del, (, ), ^ -->
            <Button Grid.Row="0" Grid.Column="0" Content="C" Margin="2" Background="Red" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Click="R_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="Del" Margin="2" Background="Orange" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Click="Del_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="(" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Content=")" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="0" Grid.Column="4" Content="^" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>

            <!-- 2 ряд: 7, 8, 9, / (растянут на 2 колонки) -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="/" Margin="2" Background="Blue" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>

            <!-- 3 ряд: 4, 5, 6, * (растянут на 2 колонки) -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Content="*" Margin="2" Background="Blue" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>

            <!-- 4 ряд: 1, 2, 3, - (растянут на 2 колонки) -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Content="-" Margin="2" Background="Blue" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>

            <!-- 5 ряд: 0, ., ), + -->
            <Button Grid.Row="4" Grid.Column="0" Content="0" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="4" Grid.Column="1" Content="." Margin="2" Background="RoyalBlue" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content=")" Margin="2" Background="RoyalBlue" Foreground="White" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Content="+" Margin="2" Background="Blue" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Button_Click"/>
        </Grid>

        <!-- Кнопка РАВНО -->
        <Button Grid.Row="6" Content="=" Margin="2" Background="Green" Foreground="White" FontSize="24" FontWeight="Bold" BorderThickness="0" Click="Result_click"/>
    </Grid>
</Window>






